{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["pdx1"],
  "crons": [
    { "path": "/api/cron", "schedule": "*/5 * * * *" },
    { "path": "/api/retention", "schedule": "17 4 * * *" }
  ],
  "redirects": [
    {
      "source": "/:path((?!api/).*)",
      "has": [{ "type": "host", "value": "passline-seven\\.vercel\\.app" }],
      "destination": "https://station.sheridandatathon.com/:path",
      "permanent": true
    }
  ]
}
